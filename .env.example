# =====================================================================
# Nexus — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env real.
# =====================================================================

# Passo a passo para subir:      docs/banco-setup.md
# Da primeira conexão em diante: docs/banco.md
#
# =====================================================================
# BANCO DE DADOS
# =====================================================================
#
# ## Uma variável decide tudo: DATABASE_URL
#
# O tipo de banco é o **prefixo** da URL. Não existem variáveis separadas
# para usuário, senha ou host — o SQLAlchemy recebe tudo numa URL só.
#
#   sqlite:///./estoque.db                              SQLite (arquivo)
#   postgresql+psycopg://usuario:senha@host:5432/banco  PostgreSQL
#   mysql+pymysql://usuario:senha@host:3306/banco       MySQL / MariaDB
#
# ## O `+psycopg` não é decorativo
#
#   postgresql://...            → SQLAlchemy procura psycopg2 → NÃO está
#                                 instalado → erro de importação, que não
#                                 menciona banco nenhum
#   postgresql+psycopg://...    → usa psycopg 3 → funciona
#
# O mesmo vale para MySQL: sem `+pymysql`, falha.
#
# ## ⚠️ Senha com caractere especial precisa ser codificada
#
# A senha vai DENTRO de uma URL. Estes caracteres quebram o endereço:
#
#   @  :  /  #  ?  %  &  espaço
#
# Senha `P@ss#2026` → `P%40ss%232026`
#
#   python -c "import urllib.parse; print(urllib.parse.quote('P@ss#2026', safe=''))"
#
# O erro que aparece quando isso acontece fala de parsing de URL, não de
# senha — e manda procurar no lugar errado.
#
# ## ⚠️ O banco PRECISA existir antes
#
# O Nexus cria as **tabelas**, não o banco. Num PostgreSQL externo, crie antes:
#
#   CREATE DATABASE nexus;
#   CREATE USER nexus WITH PASSWORD '...';
#   GRANT ALL PRIVILEGES ON DATABASE nexus TO nexus;
#
# O usuário precisa de permissão de CREATE no schema — ele vai criar
# tabelas, índices e tipos (enum).
#
# ## O banco: PostgreSQL. Só PostgreSQL.
#
# O suporte a SQLite foi **desativado para produção**. Se `ENV=production` e a
# URL apontar para SQLite, o sistema **não sobe** — e com razão: dentro de um
# container o arquivo fica na camada efêmera, e recriar o container apaga
# ativos, usuários, fotos e histórico sem deixar rastro.
#
# SQLite continua existindo apenas como apoio dos **testes automatizados**,
# que rodam em memória e não tocam dado real.
#
# ## Não é preciso definir nada para começar
#
# No `docker-compose.yml`, o `DATABASE_URL` é montado a partir de
# `POSTGRES_USER` / `POSTGRES_PASSWORD` / `POSTGRES_DB`. Deixando vazio, usa o
# PostgreSQL do compose — que é o caso normal.
#
# Defina `DATABASE_URL` **somente** para apontar a um PostgreSQL externo.

# --- PostgreSQL externo (descomente e ajuste) --------------------------
# Banco do compose (o padrão, sem precisar definir):
# DATABASE_URL=postgresql+psycopg://estoque:estoque@db:5432/estoque
#
# Outro servidor:
# DATABASE_URL=postgresql+psycopg://nexus:senha@10.0.0.50:5432/nexus
#
# Gerenciado (RDS, Azure, Neon) costuma exigir SSL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco?sslmode=require


# --- MySQL / MariaDB — **NÃO suportado em produção** --------------------
#
# O driver (`pymysql`) está instalado, mas o sistema **só foi exercitado em
# PostgreSQL**: `schema.sql` usa tipos do PostgreSQL, o backup usa `pg_dump`,
# e a verificação da cadeia de auditoria usa funções de janela específicas.
#
# Apontar para MySQL não falha na subida — falha no meio de uma operação, que
# é pior. Se precisar de MySQL, é trabalho de adaptação, não de configuração.
#
# DATABASE_URL=mysql+pymysql://usuario:senha@10.0.0.60:3306/nexus?charset=utf8mb4

# --- Criação automática das tabelas ------------------------------------
#
# Na subida, o Nexus:
#   1. cria as tabelas e os tipos (enum) que faltarem
#   2. acrescenta colunas novas a tabelas que já existiam
#   3. cria os índices que faltarem
#   4. acrescenta valores novos a enum do PostgreSQL (ALTER TYPE)
#   5. roda ANALYZE para o planejador escolher plano bom
#
# `true` = banco vazio fica pronto sozinho. É o padrão e o que você quer.
# `false` = você mesmo aplica o schema.sql ou uma migração (Alembic).
#
# Num banco que já tem dados, `true` é seguro: só acrescenta, nunca apaga.
AUTO_CREATE_TABLES=true

# --- Administrador inicial ---------------------------------------------
# Criado **só se não existir** um usuário com este e-mail. Rodar de novo não
# sobrescreve senha nem papel — é o que impede uma reinicialização de devolver
# o acesso padrão a quem já trocou a senha.
#
# ⚠️ Troque a senha no primeiro acesso. O sistema pede.
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=admin123

# --- Segurança / JWT ---------------------------------------------------
# Gere segredos fortes: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-segredo-jwt
QR_HMAC_SECRET=troque-este-segredo-qr-hmac

# --- Assinatura do QR Code ---------------------------------------------
# true  = exige assinatura válida (padrão, mais seguro)
# false = aceita a etiqueta pelo ID do payload mesmo com assinatura divergente.
#         Use false se você já tem etiquetas impressas e não quer reimprimir.
QR_EXIGIR_ASSINATURA=true
# Segredos ANTIGOS aceitos na validação, separados por vírgula.
# Permite trocar o QR_HMAC_SECRET sem invalidar as etiquetas já coladas.
QR_HMAC_SECRETS_ANTERIORES=

# --- Tokens ------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Impressão ----------------------------------------------------------
# Agente de impressão Raspberry Pi (raspberry_print_agent.py)
PRINT_AGENT_URL=http://192.168.0.50:9100
PRINT_AGENT_TIMEOUT=30
# Fallback CUPS local (opcional)
CUPS_PRINTER_DEFAULT=zebra

# Fila compartilhada no LINUX (smbclient). No Windows deixe em branco — lá o
# spooler usa a conta que roda o serviço. Em branco = tenta acesso anônimo.
PRINT_SMB_USUARIO=
PRINT_SMB_SENHA=

# --- Backup -------------------------------------------------------------
# Pasta dos backups. Aponte para o compartilhamento de rede MONTADO no host
# (ex.: /mnt/backups ou Z:\). Vazio = <pasta do projeto>/backups
BACKUP_DIR=
# Quantos backups manter antes de apagar os mais antigos
BACKUP_RETER=30

# --- Reporte de erro ---------------------------------------------------
# Recurso temporario (fase de implantacao). Desligue com false quando nao
# precisar mais: a tela sai do menu e a API recusa novos envios. O que ja foi
# reportado continua acessivel ao administrador.
REPORTE_ERRO_ATIVO=true

# --- CORS --------------------------------------------------------------
# Origens permitidas separadas por vírgula (produção: seu domínio HTTPS)
CORS_ORIGINS=http://localhost:4545,http://127.0.0.1:4545

# --- App ---------------------------------------------------------------
ENV=development
# Criar/atualizar tabelas automaticamente no startup
# (adiciona colunas novas sem apagar o banco; em prod prefira alembic)
AUTO_CREATE_TABLES=true
# Usuário administrador local (a exceção que NÃO depende do AD)
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Chave mestra das licenças de software (app/core/segredos.py)
# ---------------------------------------------------------------------------
# ATENCAO: guarde esta chave num cofre SEPARADO do banco de dados.
#
# Sem ela, as chaves de licenca cadastradas sao IRRECUPERAVEIS. O backup do
# banco nao ajuda, porque a chave mestra nao esta nele -- de proposito. E o
# que impede que quem rouba o backup leia as licencas.
#
# Para girar a chave sem perder os valores antigos:
#   NEXUS_CHAVE_LICENCAS_V1 = <a chave que estava em uso>
#   NEXUS_CHAVE_LICENCAS    = <a chave nova>
#   NEXUS_CHAVE_LICENCAS_VERSAO = 2
# GERE A SUA. O valor abaixo e um MARCADOR, nao uma chave utilizavel.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ATENCAO: se voce usar este marcador como chave, ele e publico (esta no
# repositorio) e qualquer um decifra as suas licencas.
NEXUS_CHAVE_LICENCAS=GERE-A-SUA-CHAVE-com-o-comando-acima
NEXUS_CHAVE_LICENCAS_VERSAO=1

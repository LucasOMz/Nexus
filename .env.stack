# =====================================================================
# Nexus — variáveis para a STACK do Portainer
# =====================================================================
#
# Cole este conteúdo em:
#   Portainer → Stacks → sua stack → Environment variables → "Advanced mode"
#
# O formato aceito ali é `CHAVE=valor`, uma por linha. Comentários com `#`
# normalmente são ignorados pelo editor; se a stack recusar, remova as linhas
# que começam com `#`.
#
# ## O que você PRECISA trocar antes de subir
#
#   POSTGRES_PASSWORD      senha do banco do compose
#   SEED_ADMIN_PASSWORD    senha do administrador
#   CORS_ORIGINS           domínio real de acesso
#
# ## O que você NÃO precisa definir
#
#   JWT_SECRET             deixe vazio → gerado e guardado no volume `segredos`
#   QR_HMAC_SECRET         idem
#   NEXUS_CHAVE_LICENCAS   idem
#   DATABASE_URL           vazio → usa o PostgreSQL do compose
#
# Definir um segredo à mão **desliga a geração automática** para ele. Só faça
# isso para migrar de uma instalação antiga ou para rotacionar — e guarde o
# valor num cofre, porque a chave mestra não vai no backup do banco.
# =====================================================================


# --- Banco PostgreSQL do compose ---------------------------------------
# Usados pelo serviço `db` e para montar o DATABASE_URL da API.
POSTGRES_USER=estoque
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=estoque

# --- Banco externo (opcional) ------------------------------------------
# Deixe VAZIO para usar o PostgreSQL do compose (o caso normal).
# Preencha para apontar a outro servidor:
#   postgresql+psycopg://usuario:senha@10.0.0.50:5432/nexus
# Gerenciado (RDS/Azure/Neon) costuma exigir SSL: ...?sslmode=require
# Senha com @ : / # ? % & precisa ser codificada (P%40ss%232026).
DATABASE_URL=

# --- Segredos (deixe vazio: são gerados no primeiro boot) --------------
JWT_SECRET=
QR_HMAC_SECRET=
NEXUS_CHAVE_LICENCAS=
NEXUS_CHAVE_LICENCAS_VERSAO=1

# --- QR Code -----------------------------------------------------------
# Assinatura das etiquetas já impressas (troca de chave sem reimprimir).
QR_HMAC_SECRETS_ANTERIORES=
# true = exige assinatura válida (recomendado)
QR_EXIGIR_ASSINATURA=true

# --- Acesso ------------------------------------------------------------
# Origens permitidas, separadas por vírgula. **Deixe vazio.**
#
# O frontend é servido pela MESMA aplicação que serve a API — ele chama
# `/api/v1/...` em caminho relativo. O navegador nunca faz requisição
# cross-origin, e CORS não entra em jogo.
#
# Isso vale também com proxy reverso: o navegador vê `https://seu-dns`, o
# nginx encaminha para `:4545`, e o que chega ao navegador continua sendo a
# mesma origem.
#
# Só preencha se o frontend for servido de OUTRO host (deploy separado), ou
# se um cliente externo chamar a API pelo navegador. Ex.:
#   CORS_ORIGINS=https://painel.suaempresa.com,https://app.suaempresa.com
CORS_ORIGINS=

# Porta publicada no host (a interna do container é sempre 4545).
API_PORT=4545

# --- Administrador inicial ---------------------------------------------
# Criado só se o e-mail não existir. Trocar a senha aqui depois NÃO altera um
# usuário já criado — a troca é feita pela tela, no primeiro acesso.
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=troque-esta-senha

# --- Impressão ---------------------------------------------------------
# Agente Raspberry que entrega o trabalho às impressoras térmicas.
PRINT_AGENT_URL=http://raspberry:9100

# --- Backup ------------------------------------------------------------
# Dias de retenção no volume `backups`.
BACKUP_RETER=30
